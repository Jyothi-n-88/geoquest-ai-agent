# Server Configuration (Cloud Run defaults to PORT=8080 or local 3000)
PORT=3000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/geoquest?retryWrites=true&w=majority
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/geoquest?retryWrites=true&w=majority"

# Gemini API Key (Required for autonomous spatial reasoning & ReAct function calling)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Frontend Origin for CORS configuration
FRONTEND_URL="http://localhost:3000"

# Mapbox Public Access Token (pk.eyJ...)
# Used by frontend Map component to render interactive vector tiles
VITE_MAPBOX_TOKEN="pk.eyJ1IjoiZXhhbXBsZXVzZXIiLCJhIjoiY2xleGFtcGxlMDAwMDAwMDB4eHh4eHh4In0.example"

# APP_URL: The URL where this applet is hosted on Cloud Run / AI Studio
APP_URL="MY_APP_URL"
